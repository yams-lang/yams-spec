    family-names: Rothenberg
    orcid: "https://orcid.org/0009-0001-3651-229X"
version: "1.0.0"
date-released: "2026-08-03"
repository-code: "https://github.com/yams-lang/yams-spec"
license: CC-BY-4.0
keywords:
  - dataflow
  - node graph
  - patch format
  - interchange format
  - YAML
  - modular synthesis
  - domain-specific language
